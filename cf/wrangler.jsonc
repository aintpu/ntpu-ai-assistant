{
  // Cloudflare Worker + Container：把既有的 FastAPI 後端原樣跑在 Containers 上，
  // Worker 只做轉發。部署由 .github/workflows/deploy.yml 在 CI 執行，
  // 因此本機不需要安裝 Docker。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ntpu-aia-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // 正式網域。以設定檔宣告而非在後台點選，好處是版本控制、可重現，
  // 且與部署同一個流程。Cloudflare 會自動建立 DNS 記錄並簽發憑證
  // （ntpu.ai 的 zone 已在同一帳號下，故不需指定 zone_id）。
  "routes": [
    {
      "pattern": "aia.ntpu.ai",
      "custom_domain": true
    }
  ],

  // 前端（Next.js 靜態輸出）與後端放在同一個 Worker：同源即免除 CORS，
  // 前端呼叫 /api/... 是相對路徑，不需要知道後端網址。
  //
  // 預設是「先找靜態檔，找不到才進 Worker」；/api/* 沒有對應檔案本來就會進
  // Worker，但明確列出可避免日後新增同名靜態檔時被意外攔截。
  "assets": {
    "directory": "../front_end/sports-ai-chat/out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },

  // image 指向專案根目錄的 Dockerfile；build context 為 repo 根目錄，
  // 這樣 crawler_data/ 等資料檔才會一起進映像檔。
  "containers": [
    {
      "class_name": "NtpuAiaBackend",
      "image": "../Dockerfile",
      "image_build_context": "..",
      // basic：0.25 vCPU / 1 GiB / 4 GB。Memory 與 Disk 依「配置資源 × 運行時間」
      // 計費，與實際用量無關，因此配置越貼近實需越省。Dashboard 觀測穩態約
      // 510 MiB RAM、826 MiB Disk，1 GiB / 4 GB 仍有餘裕。
      // 出現 OOM、CPU 飽和或 latency 明顯上升時，回頭改 standard-1
      //（0.5 vCPU / 4 GiB / 8 GB）；仍不足再上 standard-2（1 vCPU / 6 GiB）。
      "instance_type": "basic",
      // 單一執行個體即可：索引在啟動時載入，多開一份就多算一次記憶體費用。
      "max_instances": 1
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "BACKEND",
        "class_name": "NtpuAiaBackend"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NtpuAiaBackend"]
    }
  ],

  "observability": {
    "enabled": true
  }

  // 部署後需另外設定金鑰（只需做一次，CI 不會覆蓋）：
  //   npx wrangler secret put OPENAI_API_KEY --config cf/wrangler.jsonc
  //
  // 綁自訂網域請先用 workers.dev 測試通過後，再於後台
  // Workers & Pages → ntpu-aia-api → Settings → Domains & Routes 加入。
}
